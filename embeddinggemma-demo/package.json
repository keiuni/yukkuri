{
  "name": "embeddinggemma-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Browser demo and E2E verification for google/embeddinggemma-300m (ONNX, transformers.js)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "download-model": "node scripts/download-model.mjs",
    "download-phone-models": "node scripts/download-phone-models.mjs",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "report": "node scripts/make-report.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "record": "node scripts/record-demo.mjs",
    "agent": "node agent/run.mjs",
    "phone-check": "node scripts/phone-check.mjs",
    "char-generate": "node scripts/char-generate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  }
}
